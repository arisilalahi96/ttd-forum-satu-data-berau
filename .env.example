# Port server (diisi otomatis oleh Render / Railway)
PORT=3000

# Kode Rapat yang harus dimasukkan peserta saat membuka link
MEETING_CODE=SDI2026

# PIN untuk masuk ke Panel Panitia (mengunci dokumen, ubah kode, reset TTD, edit daftar)
ADMIN_PIN=202600

# Kunci rahasia untuk token sesi (ganti dengan teks acak panjang saat production)
SESSION_SECRET=ganti-dengan-kunci-rahasia-panjang-berau-2026

# OPSIONAL: PostgreSQL Connection String (sangat disarankan jika deploy ke Render Free Tier)
# Bisa pakai database PostgreSQL gratis dari Neon.tech / Supabase / Render Postgres.
# Jika dikosongkan, data otomatis disimpan secara lokal di folder ./data/
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
